{
  "info": {
    "name": "CuidartePlus Nicolás EP3",
    "description": "Colección mínima para ejecución de CP de Nicolás (API local Docker).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4444" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login medico",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) { pm.environment.set('token', j.token); pm.collectionVariables.set('token', j.token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"medico\",\n  \"password\": \"medico\"\n}"
            },
            "url": "{{baseUrl}}/autenticacion/login"
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) { pm.environment.set('token', j.token); pm.collectionVariables.set('token', j.token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/autenticacion/login"
          }
        },
        {
          "name": "Login paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) { pm.environment.set('token', j.token); pm.collectionVariables.set('token', j.token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"paciente\",\n  \"password\": \"paciente\"\n}"
            },
            "url": "{{baseUrl}}/autenticacion/login"
          }
        },
        {
          "name": "Login invalido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"medico\",\n  \"password\": \"ClaveIncorrecta#1\"\n}"
            },
            "url": "{{baseUrl}}/autenticacion/login"
          }
        }
      ]
    },
    {
      "name": "02 Pacientes",
      "item": [
        {
          "name": "GET Pacientes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/pacientes"
          }
        }
      ]
    },
    {
      "name": "03 Examenes",
      "item": [
        {
          "name": "GET Examenes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/examenes"
          }
        }
      ]
    },
    {
      "name": "04 Usuarios",
      "item": [
        {
          "name": "GET Usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/usuarios"
          }
        }
      ]
    },
    {
      "name": "05 Auditoria",
      "item": [
        {
          "name": "GET Auditoria",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auditoria"
          }
        }
      ]
    }
  ]
}
